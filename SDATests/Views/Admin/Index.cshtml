@model QuestionVewModel
@{
    ViewData["Title"] = "Добавить вопрос";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Новый вопрос ПДД</h4>
        </div>
        <div class="card-body p-4">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" asp-controller="Admin" asp-action="Add">

                <div class="mb-3">
                    
                    <label class="form-label fw-bold">Текст вопроса</label>
                    <textarea class="form-control" rows="3" asp-for="Text"></textarea>
                    <span class="text-danger small"></span>
                    
                    <span asp-validation-for="Text"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Изображение</label>
                    <input type="file" class="form-control" accept="image/jpeg, image/png, image/webp">
                    <span class="text-danger small"></span>
                </div>

                
                <div class="mb-4">
                    <label class="form-label fw-bold">Варианты ответов</label>

                    <div id="answers-container" class="mb-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            
                            <span asp-validation-for="Answers[i].Text"></span>
                            <div class="input-group mb-2 answer-row">
                                <input class="form-control" asp-for="Answers[i].Text">
                                <span class="input-group-text bg-white">
                                    <div class="form-check m-0">
                                        <input class="form-check-input answer-correct"
                                               type="radio"
                                               asp-for="CorrectIndex"
                                               value="@i">
                                        <label class="form-check-label small mb-0">✓</label>
                                    </div>
                                </span>
                                
                            </div>
                            
                        }
                    </div>

                    <div class="form-text text-muted mt-1">Отметьте галочкой ровно один правильный ответ.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Сохранить в БД
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}